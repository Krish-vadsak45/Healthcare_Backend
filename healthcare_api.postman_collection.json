            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Michael Scott\",\n  \"age\": 44,\n  \"gender\": \"Male\",\n  \"contact_number\": \"+1-555-0144\",\n  \"email\": \"michael.scott@dundermifflin.com\",\n  \"address\": \"1725 Slough Ave, Scranton, PA\",\n  \"medical_history\": \"Foot burned on George Foreman grill\"\n}"
